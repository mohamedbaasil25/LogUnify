# Copy to ./.env (never commit it). Generate every <generate> value:  python3 -c "import secrets;print(secrets.token_urlsafe(48))"
LOGUNIFY_VERSION=1.0.0
LOGUNIFY_AUTH_MODE=jwt
LOGUNIFY_JWT_SECRET=<generate>                  # >= 32 bytes
LOGUNIFY_AUDIT_HMAC_KEY=<generate>
LOGUNIFY_STATE_HMAC_KEY=<generate>              # signs persisted model blobs
LOGUNIFY_RAW_ARCHIVE_ENABLED=true               # exact received bytes, AES-256-GCM (required to keep raw when PII redaction is on)
LOGUNIFY_RAW_ARCHIVE_KEY=<generate: python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())">   # back it up
LOGUNIFY_ALERT_SCORE_THRESHOLD=0.80             # provisional, unvalidated: 7-day calibration on real traffic pending
LOGUNIFY_ALERT_DEDUP_MINUTES=30
LOGUNIFY_ALERT_MAX_NOTIFICATIONS_PER_HOUR=20
LOGUNIFY_ALERT_TEAMS_WEBHOOK_URL=               # https only; set at least one channel
LOGUNIFY_ALERT_SLACK_WEBHOOK_URL=
LOGUNIFY_ALERT_SMTP_HOST=
LOGUNIFY_ALERT_SMTP_PORT=587
LOGUNIFY_ALERT_SMTP_SECURITY=starttls
LOGUNIFY_ALERT_SMTP_USER=
LOGUNIFY_ALERT_SMTP_PASSWORD=
LOGUNIFY_ALERT_EMAIL_FROM=soc@example.com
LOGUNIFY_ALERT_EMAIL_TO=oncall@example.com
LOGUNIFY_WINDOWS_LISTEN=127.0.0.1               # listener published on loopback; stunnel (6514, client certs) is the only network entry
LOGUNIFY_SYSLOG_MAX_MESSAGE_BYTES=32768
LOGUNIFY_RECENT_BUFFER=50000
