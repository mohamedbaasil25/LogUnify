# LogUnify settings for the Windows Security source (copy into your .env / secret store; see logunify-backend/docs/WINDOWS_SECURITY.md)
LOGUNIFY_RECENT_BUFFER=50000
LOGUNIFY_SYSLOG_MAX_MESSAGE_BYTES=32768
LOGUNIFY_STATE_PERSIST_LOGS=true
# 32+ random bytes: python -c "import secrets; print(secrets.token_urlsafe(48))"   (persists the learned model across restarts)
LOGUNIFY_STATE_HMAC_KEY=
# compose overlay (deploy/compose.windows-security.yaml): address to publish the listener on. 127.0.0.1 when stunnel runs on the same host.
LOGUNIFY_WINDOWS_LISTEN=127.0.0.1
LOGUNIFY_BACKEND_MEM=2g
# at least one channel, otherwise alerts are only recorded and nobody is told
LOGUNIFY_ALERT_SLACK_WEBHOOK_URL=
LOGUNIFY_ALERT_TEAMS_WEBHOOK_URL=
# alert threshold: leave at the default until the calibration page has data (docs section 8)
