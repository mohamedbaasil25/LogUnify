; TLS terminator in front of the LogUnify TCP listener (which has no TLS and no authentication). Mutual TLS = only hosts holding a certificate
; from YOUR CA can send. Runs on the LogUnify host; LogUnify's listener stays on loopback (LOGUNIFY_WINDOWS_LISTEN=127.0.0.1).
; Not run by the author against a live stunnel / NXLog: treat as a starting point.
foreground = no
setuid = stunnel4
setgid = stunnel4

[logunify-windows]
accept     = 0.0.0.0:6514
connect    = 127.0.0.1:5514
cert       = /etc/stunnel/logunify-server.crt
key        = /etc/stunnel/logunify-server.key
CAfile     = /etc/stunnel/forwarders-ca.crt
verifyChain = yes
requireCert = yes
sslVersion  = TLSv1.2
