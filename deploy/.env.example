# Copy to ../.env (repository root, next to compose.yaml). Never commit the real file.
LOGUNIFY_VERSION=dev
LOGUNIFY_JWT_SECRET=                 # HS256 shared secret; required unless an IdP JWKS is configured below: python -c "import secrets; print(secrets.token_urlsafe(48))"
LOGUNIFY_AUTH_MODE=jwt
LOGUNIFY_AUDIT_HMAC_KEY=             # recommended: a second random secret
LOGUNIFY_PARTITIONS=6                # >= the number of backend replicas you intend to run
LOGUNIFY_MOCK_ENABLED=false          # true = built-in demo traffic generator (never for production)
LOGUNIFY_RAW_ARCHIVE_ENABLED=false   # true needs LOGUNIFY_RAW_ARCHIVE_KEY = base64 of 32 random bytes
LOGUNIFY_RAW_ARCHIVE_KEY=
LOGUNIFY_CORS_ORIGINS=               # empty = none (the dashboard uses its same-origin proxy)
# --profile siem:
ES_URL=
SPLUNK_HEC_URL=
LOGUNIFY_SECRETS_DIR=./secrets       # files: es_authorization ("ApiKey <base64>"), splunk_hec_token
# Perimeter hardening (docs/SECURITY.md): defaults are safe; set these behind a TLS reverse proxy
LOGUNIFY_TRUSTED_PROXIES=            # e.g. 10.0.0.0/8: peers whose X-Forwarded-For is believed (otherwise the TCP peer is the client)
LOGUNIFY_RATE_LIMIT_PER_MIN=0        # per client IP, 0 = off (e.g. 1200)
LOGUNIFY_HSTS_ENABLED=false          # true only when served over TLS
LOGUNIFY_DOCS_ENABLED=false          # /docs + /openapi.json (leave off in production)
# Real identity provider (Keycloak / Entra ID / Okta): RS256 or ES256 tokens verified against the IdP's keys.
# With a JWKS you MUST also set issuer + audience (otherwise tokens the IdP issued for other apps would be accepted).
LOGUNIFY_JWT_JWKS_URL=               # https://idp.example.org/realms/soc/protocol/openid-connect/certs   (or a mounted file below for air-gapped)
LOGUNIFY_JWT_JWKS_FILE=              # path inside the container
LOGUNIFY_JWT_ISSUER=
LOGUNIFY_JWT_AUDIENCE=
LOGUNIFY_JWT_ROLES_CLAIM=roles       # Keycloak: realm_access.roles
