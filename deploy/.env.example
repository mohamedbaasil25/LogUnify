# Copy to ../.env (repository root, next to compose.yaml). Never commit the real file.
LOGUNIFY_VERSION=dev
LOGUNIFY_JWT_SECRET=                 # required: python -c "import secrets; print(secrets.token_urlsafe(48))"
LOGUNIFY_AUTH_MODE=jwt
LOGUNIFY_AUDIT_HMAC_KEY=             # recommended: a second random secret
LOGUNIFY_PARTITIONS=6                # >= the number of backend replicas you intend to run
LOGUNIFY_MOCK_ENABLED=false          # true = built-in demo traffic generator (never for production)
LOGUNIFY_RAW_ARCHIVE_ENABLED=false   # true needs LOGUNIFY_RAW_ARCHIVE_KEY = base64 of 32 random bytes
LOGUNIFY_RAW_ARCHIVE_KEY=
LOGUNIFY_CORS_ORIGINS=               # empty = none (the dashboard uses its same-origin proxy)
# --profile siem:
ES_URL=
SPLUNK_HEC_URL=
LOGUNIFY_SECRETS_DIR=./secrets       # files: es_authorization ("ApiKey <base64>"), splunk_hec_token
