# LOGUNIFY_KAFKA_ENABLED=false runs with an in-process queue (no broker needed)
LOGUNIFY_KAFKA_ENABLED=false
LOGUNIFY_KAFKA_BOOTSTRAP=localhost:9092
LOGUNIFY_KAFKA_RAW_TOPIC=logunify.raw
LOGUNIFY_KAFKA_ECS_TOPIC=logunify.ecs
LOGUNIFY_KAFKA_GROUP=logunify-pipeline
LOGUNIFY_MOCK_ENABLED=true
LOGUNIFY_MOCK_RATE=50
LOGUNIFY_QUEUE_MAX=10000
LOGUNIFY_RECENT_BUFFER=1000

# ---- Alerting + CERT-In 6-hour workflow (docs/ALERTING.md) ---------------------------------------------------
# Trigger: anomaly score EXCEEDS the threshold AND the log matches a critical, rule-matched MITRE technique.
# Run `python scripts/alert_threshold_survey.py` to see alert volume per threshold before changing it.
LOGUNIFY_ALERT_SCORE_THRESHOLD=0.9
# LOGUNIFY_ALERT_CRITICAL_TECHNIQUES=T1003,T1070,T1078,T1098,T1190,T1486,T1048     # default list is in app/alerting/defaults.py

# Alert API (X-API-Key header). Unset = the /api/v1/alerts API is disabled. Keep secrets out of this file in real deployments.
# LOGUNIFY_ALERT_API_KEY=change-me-long-random-value
LOGUNIFY_ALERT_DB_PATH=data/alerts.db

# Webhook (https; HMAC-SHA256 signed so the receiver can verify it)
# LOGUNIFY_ALERT_WEBHOOK_URL=https://soar.example.org/hooks/logunify
# LOGUNIFY_ALERT_WEBHOOK_SECRET=change-me

# Email (STARTTLS by default)
# LOGUNIFY_ALERT_SMTP_HOST=smtp.example.org
# LOGUNIFY_ALERT_SMTP_PORT=587
# LOGUNIFY_ALERT_SMTP_USER=alerts@example.org
# LOGUNIFY_ALERT_SMTP_PASSWORD=change-me
# LOGUNIFY_ALERT_EMAIL_FROM=logunify@example.org
# LOGUNIFY_ALERT_EMAIL_TO=soc@example.org,ciso@example.org

# Reporter / Point of Contact that fills the CERT-In form (Directions para (iii), Annexure II)
# LOGUNIFY_ORG_NAME=Example Ltd
# LOGUNIFY_ORG_ADDRESS=1 Example Road, Mumbai 400001
# LOGUNIFY_ORG_LOCATION=Mumbai, Maharashtra, India
# LOGUNIFY_ORG_ISP=Example ISP
# LOGUNIFY_ORG_CRITICAL_ASSETS=db-*,pay-*,10.9.*
# LOGUNIFY_POC_NAME=Asha Rao
# LOGUNIFY_POC_DESIGNATION=CISO
# LOGUNIFY_POC_EMAIL=ciso@example.org
# LOGUNIFY_POC_MOBILE=+91 90000 00001

# ---- Access control (RBAC) + audit log ---------------------------------------------------------------------------
# auth_mode=off (default) = everyone is admin (dev only). jwt = Authorization: Bearer <HS256 token>, roles viewer|analyst|admin
# LOGUNIFY_AUTH_MODE=jwt
# LOGUNIFY_JWT_SECRET=<at least 32 random bytes>
# LOGUNIFY_JWT_ISSUER=https://gateway.example.org
# LOGUNIFY_JWT_AUDIENCE=logunify
# LOGUNIFY_JWT_ROLES_CLAIM=roles            # or realm_access.roles
# LOGUNIFY_AUDIT_DB_PATH=data/audit.db
# LOGUNIFY_AUDIT_HMAC_KEY=<random secret>   # keyed chain: DB write access alone cannot forge the audit log

# ---- PII redaction (before enrichment, batching, SIEM) ---------------------------------------------------------------
# LOGUNIFY_PII_ENABLED=true
# LOGUNIFY_PII_TYPES=card,email,ssn,aadhaar,pan     # optional: phone
# LOGUNIFY_PII_MODE=mask                            # or hash (needs LOGUNIFY_PII_HASH_KEY)
# LOGUNIFY_PII_HASH_KEY=<random secret>

# ---- Compliance reports -------------------------------------------------------------------------------------------------
# LOGUNIFY_FORWARDER_ROOT=../logunify-forwarder
# LOGUNIFY_ES_URL=https://es.example.org:9200       # enables the live ILM check
# LOGUNIFY_ES_API_KEY=<base64 id:key with monitor + read_ilm>
# LOGUNIFY_COMPLIANCE_REPORT_INTERVAL_HOURS=24

# ---- Syslog listeners (unset port = off). 514 needs elevated rights on Linux; no TLS, so keep loopback or front with a TLS proxy
# LOGUNIFY_SYSLOG_BIND=127.0.0.1
# LOGUNIFY_SYSLOG_UDP_PORT=5514
# LOGUNIFY_SYSLOG_TCP_PORT=5514
# LOGUNIFY_SYSLOG_QUEUE_MAX=10000
# LOGUNIFY_SYSLOG_MAX_MESSAGE_BYTES=8192
# LOGUNIFY_SYSLOG_MAX_CONNECTIONS=256
# LOGUNIFY_SYSLOG_IDLE_TIMEOUT_S=300

# ---- Durable state (sources, IOC feeds, Merkle batches + anchors, recent logs/anomalies) -----------------------------
# LOGUNIFY_STATE_ENABLED=true
# LOGUNIFY_STATE_DB_PATH=data/state.db
# LOGUNIFY_STATE_FLUSH_INTERVAL_S=5         # a crash loses at most this much
# LOGUNIFY_STATE_PERSIST_LOGS=true          # false = keep recent logs / anomalies out of the file

# ---- Real forwarding to Elasticsearch (Bulk API). Off by default. Not together with Vector's ES sink on the same index. ----
# LOGUNIFY_ES_FORWARD_ENABLED=true
# LOGUNIFY_ES_URL=https://es.example.org:9200
# LOGUNIFY_ES_FORWARD_API_KEY=<base64 id:key with create_doc + auto_configure on logs-logunify-*>
# LOGUNIFY_ES_FORWARD_INDEX=logs-logunify-prod
# LOGUNIFY_ES_FORWARD_MAX_RETRIES=6
# LOGUNIFY_ES_FORWARD_DLQ_PATH=data/es-dlq.jsonl
# LOGUNIFY_ES_VERIFY_SSL=true

# ---- Pipeline: no-loss delivery, traceability, parsers, taxonomy, scale-out (docs/PIPELINE.md) ------------------------------
# LOGUNIFY_DEFAULT_TIMEZONE=UTC                    # zone for timestamps without a UTC offset (per source: "timezone" on the source)
# LOGUNIFY_DLQ_PATH=data/dlq.jsonl                 # logs that could not be normalized: kept, replayable (POST /api/v1/dlq/replay)
# LOGUNIFY_DLQ_MAX_MB=512
# LOGUNIFY_TAXONOMY_MODE=warn                      # ECS validation: off | warn | strict (dead-letter violators)
# LOGUNIFY_PARSER_DIR=parsers.d                    # extra parsers: *.yaml (declarative) / *.py (plugins)
# LOGUNIFY_BATCH_MAX=500                           # logs fetched and committed together
# LOGUNIFY_PROCESS_CHUNK=32                        # logs per event-loop slice
# LOGUNIFY_KAFKA_PUBLISH_MAX_WAIT_S=300            # retry ECS publishing this long before dead-lettering
# LOGUNIFY_KAFKA_COMPRESSION=gzip                  # gzip | none
# LOGUNIFY_WORKER_ID=auto                          # per replica; "{worker}" in any storage path expands to it
# LOGUNIFY_CORS_ORIGINS=                           # explicit origins only; empty = no CORS ("*" is refused)
# LOGUNIFY_RAW_ARCHIVE_ENABLED=true                # encrypted unredacted originals, the evidence behind event.hash
# LOGUNIFY_RAW_ARCHIVE_KEY=<base64 of 32 random bytes: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())">
# LOGUNIFY_RAW_ARCHIVE_DIR=data/raw
# LOGUNIFY_RAW_ARCHIVE_RETENTION_DAYS=180

# ---- Perimeter hardening (docs/SECURITY.md section 5) -----------------------------------------------------------------------
# LOGUNIFY_DOCS_ENABLED=false           # /docs, /openapi.json (off by default)
# LOGUNIFY_MAX_BODY_BYTES=8388608       # 413 above this (0 = unlimited)
# LOGUNIFY_TRUSTED_PROXIES=10.0.0.0/8   # whose X-Forwarded-For is believed
# LOGUNIFY_RATE_LIMIT_PER_MIN=0         # per client IP; health/readiness/stream exempt
# LOGUNIFY_AUTH_FAIL_MAX=10             # machine-credential failures (alert API key, source token) per window ...
# LOGUNIFY_AUTH_FAIL_WINDOW_S=60
# LOGUNIFY_AUTH_LOCK_S=300              # ... lock that client+target this long (429)
# LOGUNIFY_HSTS_ENABLED=false
